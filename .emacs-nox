        (elisp-mode       . elisp-ts-mode)
        (cmake-mode       . cmake-ts-mode)
        (dockerfile-mode  . dockerfile-ts-mode)
        (json-mode        . json-ts-mode)
        (java-mode        . java-ts-mode)
        (yaml-mode        . yaml-ts-mode)
        (makefile-mode    . makefile-ts-mode)
        ))

