(defun my-vscode-layout ()
  "Neotree 左侧，右侧上下分为代码和 vterm，放大代码窗口，焦点回代码。"
  (interactive)
  (let ((orig-buffer (current-buffer)))
    ;; 删除所有窗口，统一布局
    (delete-other-windows)
    ;; 打开 Neotree（会自动左右分割）
    (neotree-show)
    ;; 选中右侧工作区
    (select-window (next-window))
    ;; 上下分割：上是代码，下是 eshell
    (split-window-below)
    ;; 当前是上窗口，记录下来
    (let ((code-win (selected-window)))
      ;; 选中下窗口并打开 eshell
      (other-window 1)
      (vterm)
      ;; 回到上窗口并还原 buffer
      (select-window code-win)
      (switch-to-buffer orig-buffer)
      ;; 放大代码区窗口，让 eshell 更小（例如放大 10 行）
      (enlarge-window 10)
      )))

(global-set-key (kbd "C-c v") #'my-vscode-layout)

;; 快捷键定义必须放在后面否则容易被其他插件覆盖
;;enhancement for help
(use-package helpful
  :ensure t
  :bind
  (("C-h f" . helpful-callable)    ;; 替换 describe-function
   ("C-h v" . helpful-variable)    ;; 替换 describe-variable
   ("C-h k" . helpful-key)         ;; 替换 describe-key
   ("C-h x" . helpful-command)     ;; 替换 describe-command
   ("C-c C-d" . helpful-at-point)  ;; 光标下符号
   ("C-h F" . helpful-function)))  ;; 查看函数，不含宏

(defun kill-other-buffers ()
  "Kill all buffers except the current one."
  (interactive)
  (mapc (lambda (buf)
          (unless (eq buf (current-buffer))
            (kill-buffer buf)))
        (buffer-list)))

;; 关闭其他buffers
(global-set-key (kbd "C-c k") #'kill-other-buffers)
;;撤销
(global-set-key (kbd "C-/") 'undo-only)
;;撤销刚才的撤销
(global-set-key (kbd "C-?") 'undo-redo)
