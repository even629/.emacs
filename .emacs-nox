(defun my/kill-scratch-buffer ()
  "在 Emacs 启动时关闭 *scratch* buffer."
  (when (get-buffer "*scratch*")
    (kill-buffer "*scratch*")))
(add-hook 'emacs-startup-hook #'my/kill-scratch-buffer)

;;在执行操作（如撤销、替换、复制）时提供视觉反馈。
