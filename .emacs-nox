                            markdown-mode-hook
                            bash-mode-hook bash-ts-mode-hook
                            sh-mode-hook sh-ts-mode-hook
                            latex-mode-hook LaTeX-mode-hook
                            ))
  (add-hook hook 'eglot-ensure))

